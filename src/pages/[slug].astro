---
import Aiworld from '../layouts/Aiworld.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('clanky_en');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const base = import.meta.env.BASE_URL;
const skHref = `${base}clanky/${article.data.sk_slug}/`;
const dateStr = article.data.date.toISOString().split('T')[0];

const CAT_LABEL: Record<string, string> = {
  'ai-zaklady': 'Foundations',
  'ai-v-praxi': 'In practice',
  'ai-trendy': 'Trends',
};
---

<Aiworld
  title={article.data.title}
  description={article.data.description}
  skHref={new URL(skHref, Astro.site ?? Astro.url).href}
>
  <article class="post">
    <a class="back" href={`${base}/`}>← All articles</a>

    <div class="meta">
      <span class="cat">{CAT_LABEL[article.data.category] ?? article.data.category}</span>
      <span class="dot">·</span>
      <time>{dateStr}</time>
      {article.data.reading_time && (
        <>
          <span class="dot">·</span>
          <span>{article.data.reading_time} min read</span>
        </>
      )}
    </div>

    <div class="prose">
      <Content />
    </div>

    <div class="sk-note">
      <span>Originally written in Slovak.</span>
      <a href={skHref}>Read the Slovak version ↗</a>
    </div>
  </article>
</Aiworld>

<style>
  .post { max-width: 720px; margin: 0 auto; padding: 48px 0 0; }
  .back {
    font-family: var(--font-mono, monospace); font-size: 13px;
    color: var(--ink-600); text-decoration: none;
  }
  .back:hover { color: var(--ai-cyan); }
  .meta {
    display: flex; gap: 8px; align-items: center; margin: 28px 0 8px;
    font-family: var(--font-mono, monospace); font-size: 12px; color: var(--ink-600);
  }
  .meta .cat { color: var(--ai-violet); text-transform: uppercase; letter-spacing: 0.04em; }
  .dot { opacity: 0.5; }

  .prose { font-size: 17px; line-height: 1.7; color: var(--ink-400); }
  .prose :global(h1) {
    font-family: var(--font-heading, 'Geist', sans-serif); font-weight: 800;
    font-size: clamp(28px, 4vw, 40px); line-height: 1.12; letter-spacing: -0.02em;
    color: var(--ink-100); margin: 12px 0 28px;
  }
  .prose :global(h2) {
    font-family: var(--font-heading, 'Geist', sans-serif); font-weight: 700;
    font-size: 25px; color: var(--ink-100); margin: 44px 0 14px; letter-spacing: -0.01em;
  }
  .prose :global(h3) {
    font-family: var(--font-heading, 'Geist', sans-serif); font-weight: 600;
    font-size: 19px; color: var(--ink-100); margin: 32px 0 10px;
  }
  .prose :global(p) { margin: 0 0 20px; }
  .prose :global(strong) { color: var(--ink-100); font-weight: 600; }
  .prose :global(a) { color: var(--ai-cyan); text-decoration: underline; text-underline-offset: 3px; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 20px; padding-left: 24px; }
  .prose :global(li) { margin: 0 0 8px; }
  .prose :global(blockquote) {
    border-left: 3px solid var(--ai-violet); margin: 24px 0; padding: 4px 0 4px 20px;
    color: var(--ink-100); font-style: italic;
  }
  .prose :global(code) {
    font-family: var(--font-mono, monospace); font-size: 0.9em;
    background: var(--carbon, #111118); padding: 2px 6px; border-radius: 4px;
  }

  .sk-note {
    margin: 56px 0 0; padding: 22px 0 0;
    border-top: 1px solid var(--glass-border, rgba(255,255,255,0.06));
    display: flex; flex-direction: column; gap: 6px;
    font-family: var(--font-mono, monospace); font-size: 13px; color: var(--ink-600);
  }
  .sk-note a { color: var(--ai-cyan); text-decoration: none; }
</style>
